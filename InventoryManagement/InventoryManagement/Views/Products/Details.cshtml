@model InventoryManagement.Models.Product

@{
    ViewBag.Title = "Product Details";
}

<h2>Product Details</h2>

<dl class="dl-horizontal">
    <dt>Product ID</dt>
    <dd>@Model.ProductId</dd>

    <dt>Product Name</dt>
    <dd>@Model.ProductName</dd>

    <dt>Category</dt>
    <dd>@Model.Category</dd>

    <dt>Quantity</dt>
    <dd>@Model.Quantity</dd>

    <dt>Price</dt>
    <dd>@Model.Price.ToString("0.00")</dd>

    <dt>Supplier</dt>
    <dd>@Model.SupplierName</dd>
</dl>

<p>
    @Html.ActionLink("Edit", "Edit",
            new { id = Model.ProductId },
            new { @class = "btn btn-primary" })

    @Html.ActionLink("Back to Inventory", "Index",
            null, new { @class = "btn btn-secondary" })
</p>