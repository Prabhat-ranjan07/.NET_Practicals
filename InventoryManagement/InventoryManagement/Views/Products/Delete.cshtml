@model InventoryManagement.Models.Product

@{
    ViewBag.Title = "Delete Product";
}

<h2>Delete Product</h2>

<h4>Are you sure you want to delete this product?</h4>

<dl class="dl-horizontal">
    <dt>Product ID</dt>
    <dd>@Model.ProductId</dd>

    <dt>Product Name</dt>
    <dd>@Model.ProductName</dd>

    <dt>Category</dt>
    <dd>@Model.Category</dd>

    <dt>Quantity</dt>
    <dd>@Model.Quantity</dd>

    <dt>Price</dt>
    <dd>@Model.Price.ToString("0.00")</dd>

    <dt>Supplier</dt>
    <dd>@Model.SupplierName</dd>
</dl>

@using (Html.BeginForm("Delete", "Products",
    new { id = Model.ProductId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    @Html.ActionLink("Cancel", "Index", null,
            new { @class = "btn btn-secondary" })
}